<section
  id="Testimonials-{{ section.id }}"
  class="custom-testimonials"
  style="
    --testimonial-bg: {{ section.settings.background_color }};
    --testimonial-card-bg: {{ section.settings.card_background }};
    --testimonial-text: {{ section.settings.text_color }};
    --testimonial-star: {{ section.settings.star_color }};
    --testimonial-border: {{ section.settings.border_color }};
  "
>
  <div class="custom-testimonials__container">

    {% if section.settings.heading != blank %}
      <h2 class="custom-testimonials__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div class="custom-testimonials__subheading">
        {{ section.settings.subheading }}
      </div>
    {% endif %}

    <div class="custom-testimonials__grid">
      {% for block in section.blocks %}
        <article
          class="testimonial-card"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.rating > 0 %}
            <div
              class="testimonial-card__stars"
              aria-label="{{ block.settings.rating }} out of 5 stars"
            >
              {% for i in (1..5) %}
                {% if i <= block.settings.rating %}
                  <span>★</span>
                {% else %}
                  <span class="testimonial-card__star--empty">★</span>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}

          {% if block.settings.review != blank %}
            <div class="testimonial-card__review">
              {{ block.settings.review }}
            </div>
          {% endif %}

          {% if block.settings.name != blank %}
            <div class="testimonial-card__name">
              {{ block.settings.name }}
            </div>
          {% endif %}

          {% if block.settings.location != blank %}
            <div class="testimonial-card__location">
              {{ block.settings.location }}
            </div>
          {% endif %}

        </article>
      {% endfor %}
    </div>

  </div>
</section>

<style>
  #Testimonials-{{ section.id }} {
    background: var(--testimonial-bg);
    color: var(--testimonial-text);
    width: 100%;
  }

  #Testimonials-{{ section.id }} .custom-testimonials__container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
  }

  #Testimonials-{{ section.id }} .custom-testimonials__heading {
    margin: 0;
    text-align: center;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--testimonial-text);
  }

  #Testimonials-{{ section.id }} .custom-testimonials__subheading {
    margin: 7px 0 25px;
    text-align: center;
    font-size: 12px;
    line-height: 1.4;
    color: var(--testimonial-text);
    opacity: 0.72;
  }

  #Testimonials-{{ section.id }} .custom-testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ section.settings.card_gap }}px;
  }

  #Testimonials-{{ section.id }} .testimonial-card {
    background: var(--testimonial-card-bg);
    border: 1px solid var(--testimonial-border);
    border-radius: {{ section.settings.card_radius }}px;
    padding: 18px 18px 16px;
    min-height: {{ section.settings.card_height }}px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    box-sizing: border-box;
  }

  #Testimonials-{{ section.id }} .testimonial-card__stars {
    display: flex;
    gap: 2px;
    margin-bottom: 9px;
    font-size: 12px;
    line-height: 1;
    color: var(--testimonial-star);
  }

  #Testimonials-{{ section.id }} .testimonial-card__star--empty {
    opacity: 0.2;
  }

  #Testimonials-{{ section.id }} .testimonial-card__review {
    font-size: 11px;
    line-height: 1.55;
    color: var(--testimonial-text);
    opacity: 0.78;
    margin-bottom: 13px;
    max-width: 95%;
  }

  #Testimonials-{{ section.id }} .testimonial-card__name {
    font-size: 11px;
    line-height: 1.3;
    font-weight: 600;
    color: var(--testimonial-text);
  }

  #Testimonials-{{ section.id }} .testimonial-card__location {
    margin-top: 2px;
    font-size: 9px;
    line-height: 1.3;
    color: var(--testimonial-text);
    opacity: 0.55;
  }

  @media screen and (max-width: 749px) {
    #Testimonials-{{ section.id }} .custom-testimonials__container {
      padding-left: 16px;
      padding-right: 16px;
    }

    #Testimonials-{{ section.id }} .custom-testimonials__heading {
      font-size: 26px;
    }

    #Testimonials-{{ section.id }} .custom-testimonials__grid {
      display: flex;
      overflow-x: auto;
      gap: 12px;
      padding-bottom: 5px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    #Testimonials-{{ section.id }} .custom-testimonials__grid::-webkit-scrollbar {
      display: none;
    }

    #Testimonials-{{ section.id }} .testimonial-card {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 990px) {
    #Testimonials-{{ section.id }} .custom-testimonials__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

{% schema %}
{
  "name": "testimonials",
  "tag": "section",
  "class": "section-custom-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Nature. Trusted by You"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real people. Real stories."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#F8F7F1"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FAF9F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#33312C"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#C89A27"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border",
      "default": "#E8E5DC"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
